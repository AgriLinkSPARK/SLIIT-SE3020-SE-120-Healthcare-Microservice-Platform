# Frontend Environment Variables
# Copy this file to .env in the frontend directory

# Core API configuration (Vite)
VITE_API_GATEWAY_URL=http://localhost:8081/api
VITE_PAYMENT_SERVICE_URL=http://localhost:8004

# Stripe configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY

# Legacy React scripts compatibility (optional)
REACT_APP_API_BASE_URL=http://localhost:8004/api/v1
REACT_APP_PAYMENT_SERVICE_URL=http://localhost:8004
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY
