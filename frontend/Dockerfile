FROM node:16-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_GATEWAY_URL=http://localhost:8081/api
ARG VITE_PAYMENT_SERVICE_URL=http://localhost:8004
ARG VITE_APPOINTMENT_SERVICE_URL=http://localhost:8002/api/v1/appointments
ARG VITE_TELEMEDICINE_SERVICE_URL=/api/telemedicine/sessions
ARG VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

ENV VITE_API_GATEWAY_URL=${VITE_API_GATEWAY_URL}
ENV VITE_PAYMENT_SERVICE_URL=${VITE_PAYMENT_SERVICE_URL}
ENV VITE_APPOINTMENT_SERVICE_URL=${VITE_APPOINTMENT_SERVICE_URL}
ENV VITE_TELEMEDICINE_SERVICE_URL=${VITE_TELEMEDICINE_SERVICE_URL}
ENV VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]